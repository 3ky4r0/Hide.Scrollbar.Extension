{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "icons": {
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/features/popup/popup.html",
    "default_icon": {
      "48": "assets/icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/features/favicon/favicon.html"
  },
  "options_ui": {
    "page": "src/features/settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/entries/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/features/whitelist/whitelist-service.js",
        "src/entries/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/features/draw/draw.css",
        "src/features/ruler/ruler.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
